# Virtual environment
venv/
.venv/

# Environment secrets
.env

# Runtime data. Root-level data/* ignores contents while letting us force-track
# hey_poob.onnx. src/**/data/ ignores the accidental nested data/ dirs that
# show up when poob is run from a subdirectory as cwd.
data/*
!data/hey_poob.onnx
!data/hey_poob_v3.onnx
src/**/data/
browser_profiles/

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.eggs/

# Testing
.pytest_cache/
.coverage
htmlcov/

# IDE
.vscode/
.idea/
*.swp
*.swo

# mypy
.mypy_cache/

# ruff
.ruff_cache/

# OS
.DS_Store
Thumbs.db

.claude/settings.local.json
.claude/scheduled_tasks.lock

# Stray Node.js artifacts from accidental `npm install` in the repo root.
# Poob is Python-only; package.json and node_modules/ have no place here.
# Keep ignored so they stop cluttering `git status`.
node_modules/
package.json
package-lock.json