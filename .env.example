# Discord
DISCORD_BOT_TOKEN=
DISCORD_DEALS_CHANNEL_ID=

# Ollama (local LLM) - runs on your Windows PC
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_NUM_CTX=12000
OLLAMA_JSON_TEMPERATURE=0.0
LLM_TEMPERATURE=0.3

# Cerebras (free: 30 RPM, 60K TPM, 1M tokens/day - Qwen3 235B)
# Used for retail price lookup and category estimation (world-knowledge tasks)
# Get a free key at https://cloud.cerebras.ai/
CEREBRAS_API_KEY=
CEREBRAS_MODEL=qwen-3-235b-a22b-instruct-2507

# Cloud LLM (optional - Gemini 2.5 Flash, fallback if no Cerebras key)
# Leave GOOGLE_API_KEY empty to use local LLM for everything
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.5-flash

# Facebook credentials (for persistent login)
FACEBOOK_EMAIL=
FACEBOOK_PASSWORD=

# Browser
BROWSER_HEADLESS=false
BROWSER_USE_VISION=false

# Scanning
SCAN_INTERVAL_MINUTES=15
SCAN_BROWSE_ENABLED=true

# Deal Radar v2 (skill-based)
DEAL_RADAR_ENABLED=true
DEAL_RADAR_MIN_SCORE=good
DEAL_RADAR_VERSION=v2
VISION_MODEL=qwen3-vl:8b
EBAY_LOOKUP_ENABLED=true
EBAY_HTTP_TIMEOUT_SECONDS=10
EBAY_MIN_SAMPLES=3
DEAL_RADAR_MAX_EVALUATIONS=10
DEAL_RADAR_SCAM_THRESHOLD_PCT=80
