# =============================================================================
# Poob — Environment Configuration
# Copy this file to .env and fill in the values.
# =============================================================================

# --- Discord ---
DISCORD_BOT_TOKEN=
DISCORD_DEALS_CHANNEL_ID=
DISCORD_COMMAND_PREFIX=!

# --- Ollama (local LLM) ---
# Install: https://ollama.com/download
# Pull models: ollama pull qwen3:8b && ollama pull qwen3:4b && ollama pull qwen2.5vl:3b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_NUM_CTX=12000
OLLAMA_JSON_TEMPERATURE=0.0
LLM_TEMPERATURE=0.3

# Local fast model for lightweight tasks (saves cloud quota)
LOCAL_FAST_MODEL=qwen3:4b

# Local vision model (Ollama VLM fallback)
VISION_MODEL=qwen2.5vl:3b

# Ollama performance tuning (set as system env vars BEFORE starting Ollama):
# OLLAMA_FLASH_ATTENTION=1       # Flash attention on Turing+ GPUs
# OLLAMA_KV_CACHE_TYPE=q8_0      # Halve KV cache memory
# OLLAMA_KEEP_ALIVE=-1           # Keep models loaded between patrol cycles

# --- Cerebras (primary cloud LLM) ---
# Free tier: 1K RPM, 64K TPM, 1M tokens/day. No credit card.
# https://cloud.cerebras.ai/
CEREBRAS_API_KEY=
CEREBRAS_MODEL=qwen-3-235b-a22b-instruct-2507

# --- Spotify (public-playlist URL import for music) ---
# Free; Developer Dashboard → create app → copy Client ID + Secret.
# ClientCredentials flow only — no OAuth, no Premium needed for the
# `queue_spotify_playlist` brain action. Both empty disables the action
# with a friendly soft error. See
# docs/decisions/music-spotify-playlist-import.md.
# https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- Groq (cloud LLM fallback + vision) ---
# Free tier: 30 RPM, 14,400 RPD. No credit card.
# https://console.groq.com/
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# --- Google Gemini ---
# Used for VLM evaluation, agent brain fallback, and browser fallback.
# Free tier: 15 RPM, 1M TPD.
# https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.5-flash

# --- NVIDIA NIM (browser automation + agent brain fallback) ---
# Free tier: 1K credits on signup.
# https://build.nvidia.com/
NVIDIA_API_KEY=
NVIDIA_MODEL=qwen/qwen3-next-80b-a3b-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# --- Browser ---
# Which cloud provider drives browser-use: "nvidia", "gemini", or "ollama"
BROWSER_LLM_PROVIDER=nvidia
BROWSER_HEADLESS=false
BROWSER_USE_VISION=true

# --- Facebook Credentials ---
# For persistent login (avoids login prompts during scanning)
FACEBOOK_EMAIL=
FACEBOOK_PASSWORD=

# --- Scanning ---
SCAN_MODE=direct
SCAN_INTERVAL_MINUTES=15
SCAN_MAX_LISTINGS_PER_QUERY=20
SCAN_BROWSE_ENABLED=true

# --- Deal Evaluation ---
DEAL_RADAR_ENABLED=true
DEAL_RADAR_MIN_SCORE=good
DEAL_RADAR_MAX_EVALUATIONS=30
EBAY_HTTP_TIMEOUT_SECONDS=10

# --- Web Search (cascade: Tavily -> Serper -> empty) ---
# Tavily: 1,000 free searches/month. https://tavily.com
TAVILY_API_KEY=
# Serper.dev: 2,500 free searches (one-time). https://serper.dev
SERPER_API_KEY=

# --- Visual Enrichment (reverse image search) ---
# Google Cloud Vision API: 1,000 free calls/month.
# https://console.cloud.google.com/apis/library/vision.googleapis.com
GOOGLE_CLOUD_VISION_API_KEY=
GOOGLE_CLOUD_VISION_ENABLED=true
GOOGLE_CLOUD_VISION_MONTHLY_QUOTA=1000

# SerpAPI Google Lens: 250 free searches/month. https://serpapi.com/
SERPAPI_API_KEY=
SERPAPI_ENABLED=true
SERPAPI_MONTHLY_QUOTA=250

# --- VLM Evaluation ---
# Cascade: Gemini Flash -> Groq Vision -> Gemini Pro -> OpenRouter -> Ollama
VLM_PRIMARY_PROVIDER=gemini_flash
VLM_MAX_IMAGES=2
VLM_CONFIDENCE_THRESHOLD=0.6
VLM_SECOND_OPINION_ENABLED=true
VLM_EVALUATION_TIMEOUT=30

GEMINI_FLASH_MODEL=gemini-2.5-flash
GEMINI_PRO_MODEL=gemini-2.5-pro

# --- OpenRouter (multi-model aggregator, free tier) ---
# https://openrouter.ai/
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-4-scout-17b-16e-instruct:free
OPENROUTER_ENABLED=true

# --- Text Triage (batch pre-filter) ---
TRIAGE_BATCH_SIZE=5
TRIAGE_PROVIDER=cerebras

# --- Enrichment + Comparable Sales ---
ENRICHMENT_TAVILY_ENABLED=true
ENRICHMENT_TAVILY_ONLY_WITH_PRODUCT_NAME=true

# --- Notifications ---
NOTIFICATION_MAX_PER_DAY=10
NOTIFICATION_INCLUDE_DISTANCE=true

# --- Patrol Scheduling ---
PATROL_ENABLED=true
PATROL_SWEEP_MODE=unified
PATROL_BASE_RADIUS_MILES=40
PATROL_PEAK_INTERVAL_SECONDS=300
PATROL_MODERATE_INTERVAL_SECONDS=600
PATROL_OFFPEAK_INTERVAL_SECONDS=900
PATROL_DEAD_INTERVAL_SECONDS=1800
PATROL_PEAK_HOURS_START=16
PATROL_PEAK_HOURS_END=21
PATROL_DAYS_SINCE_LISTED=1
LISTING_MAX_AGE_HOURS=6
PATROL_WATCHLIST_SWEEP_ENABLED=true

# --- Storage ---
DATABASE_PATH=data/scraper.db
LOG_DIR=data/logs
LOG_LEVEL=INFO
